{
  "manifest_version": 3,
  "name": "키워드 마스터",
  "version": "0.2.0",
  "description": "네이버 키워드 검색량·경쟁강도를 팝업 및 검색 사이트 오버레이로 바로 조회 (개인용)",
  "action": {
    "default_popup": "popup.html",
    "default_title": "키워드 마스터"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://keyword-master-delta.vercel.app/*"],
  "content_scripts": [
    {
      "matches": [
        "https://search.naver.com/search.naver*",
        "https://search.shopping.naver.com/*",
        "https://shopping.naver.com/*",
        "https://www.coupang.com/np/search*",
        "https://www.gmarket.co.kr/n/search*",
        "https://search.11st.co.kr/pc/total-search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
