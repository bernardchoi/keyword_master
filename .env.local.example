# ─────────────────────────────────────────────────────────────
# 1. 네이버 검색광고 API — 월간 검색수 / 연관 키워드 / 광고 경쟁정도
#    발급: https://searchad.naver.com  →  도구 > API 사용 관리
# ─────────────────────────────────────────────────────────────
NAVER_AD_CUSTOMER_ID=
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# 2. NAVER API HUB (네이버 클라우드 플랫폼) — 문서수 / 경쟁강도 / 추이
#    네이버가 검색·데이터랩 API 를 developers.naver.com 에서 이곳으로 이관했고,
#    구 플랫폼은 신규 등록이 막혀 있다. 신규 사용자는 이쪽을 쓴다.
#    발급: https://www.ncloud.com  →  Services > NAVER API HUB > 이용 신청
# ─────────────────────────────────────────────────────────────
NCP_API_KEY_ID=
NCP_API_KEY=

# ─────────────────────────────────────────────────────────────
# 2-B. (구버전) developers.naver.com 오픈 API
#      2019~2025년경 발급받아 아직 살아있는 키가 있다면 이것만 채워도 된다.
#      위 NCP 키가 있으면 그쪽이 우선 사용된다.
#      구 방식에만 있는 기능: 쇼핑(상품) 검색 → 쇼핑 상품수, 카테고리 분류
# ─────────────────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 3. 선택 설정
# ─────────────────────────────────────────────────────────────
# 한 번 조회할 때 문서수/카테고리까지 분석할 상위 키워드 개수.
# 비워 두면 표에 보이는 행 전부에 붙인다(권장) — 경쟁이 낮은 롱테일 키워드는
# 검색량 순위 아래쪽에 있어서, 상위 몇 개만 분석하면 정작 찾아야 할 키워드에 등급이 안 붙는다.
# 키워드 하나당 검색 API 1회를 쓴다 (100행 = 100회, 월 쿼터 775,000회).
# KM_ENRICH_LIMIT=20
# 서버 캐시 유지 시간(초). 호출 쿼터 절약용 (기본 21600 = 6시간)
KM_CACHE_TTL=21600

# ─────────────────────────────────────────────────────────────
# 4. (선택) Redis 캐시 — 서버리스 인스턴스 사이에 캐시를 공유하고 싶을 때만
#    비워 두면 프로세스 메모리 캐시만 쓴다 (로컬 개발은 이걸로 충분).
#    Vercel KV(Marketplace의 Upstash 연동)를 프로젝트에 붙이면 아래 두 값이
#    자동으로 채워진다. 직접 Upstash(https://upstash.com, 무료 티어 있음)를
#    쓴다면 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 을 대신 채워도 된다.
#    자세한 이유는 README "서버리스와 캐시" 참고.
# ─────────────────────────────────────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
